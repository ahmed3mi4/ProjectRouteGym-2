
@model Plan
@{
    ViewData["Title"] = "Plan Details";
   
}

<div class="container">
    <header class="d-flex justify-content-between mt-5 mb-4 align-items-center">
        <div>
            <h2 class="text-primary-color mb-0">Plan Details</h2>
            <p class="text-muted">Full information about this membership plan</p>
        </div>
        <a asp-controller="Plans" asp-action="Index" class="btn btn-outline btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Plans
        </a>
    </header>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0 plan-card">

                @* Header color reflects the plan's active/inactive state *@
                <div class="card-header text-white text-center py-4 @(Model.IsActive ? "bg-primary-color" : "bg-secondary")">
                    <h3 class="mb-0">@Model.Name</h3>
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger") mt-2">
                        @(Model.IsActive ? "Active" : "Inactive")
                    </span>
                </div>

                <div class="card-body">
                    <div class="text-center mb-4">
                        <div class="display-4 fw-bold text-primary-color">@Model.Price</div>
                        <small class="text-muted">EGP</small>
                    </div>

                    <ul class="list-unstyled">
                        <li class="mb-3">
                            <i class="bi bi-calendar-check text-primary-color me-2"></i>
                            <strong>Duration:</strong> @Model.DurationDays days
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-file-text text-primary-color me-2"></i>
                            <strong>Description:</strong>
                            <p class="small mt-1">@Model.Description</p>
                        </li>
                    </ul>

                    <div class="d-flex gap-2 mt-4">
                        <a asp-controller="Plans" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline btn-sm flex-fill">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                        <form asp-controller="Plans" asp-action="Activate" asp-route-id="@Model.Id" method="post" class="flex-fill">
                            <button type="submit" class="btn btn-outline btn-sm w-100">
                                @if (Model.IsActive)
                                {
                                    <i class="bi bi-x-circle me-1 text-danger"></i> @:Deactivate
                                }
                                else
                                {
                                    <i class="bi bi-check-circle me-1 text-success"></i> @:Activate
                                }
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
